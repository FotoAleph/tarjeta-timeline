---
---
<div id="preloader" class="preloader-container" aria-live="polite">
	<div class="preloader-content">
		<div class="invitation-animation" aria-label="Abriendo invitación">
			<img
				class="invitation-image invitation-closed"
				src="/assets/cerrado.webp"
				alt="Invitación cerrada"
				fetchpriority="high"
			/>
			<img
				class="invitation-image invitation-open"
				src="/assets/abierto.webp"
				alt="Invitación abierta"
			/>
		</div>

		<div class="preloader-text-container">
			<h1 class="preloader-title">mis 15 años</h1>
			<div class="loading-bar-container" aria-hidden="true">
				<div class="loading-bar" id="preload-progress"></div>
			</div>
			<p class="preloader-subtitle">29 de agosto...</p>
		</div>
	</div>
</div>

<style>
	.preloader-container {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		background: radial-gradient(circle at 50% 35%, #ffffff 0%, #f2f9ff 48%, #d8ebf7 100%);
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.8s ease, visibility 0.8s ease;
		overflow: hidden;
	}

	.preloader-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 28px;
		padding: 24px;
	}

	.invitation-animation {
		position: relative;
		width: min(78vw, 360px);
		aspect-ratio: 1 / 1;
		filter: drop-shadow(0 16px 22px rgba(2, 56, 89, 0.18));
		animation: floatInvitation 2.6s ease-in-out infinite alternate;
	}

	.invitation-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.invitation-open {
		opacity: 0;
		transform: scale(0.92);
	}

	.opened .invitation-closed {
		opacity: 0;
		transform: scale(1.08);
	}

	.opened .invitation-open {
		opacity: 1;
		transform: scale(1);
	}

	@keyframes floatInvitation {
		from { transform: translateY(0); }
		to { transform: translateY(-10px); }
	}

	.preloader-text-container {
		text-align: center;
	}

	.preloader-title {
		font-family: var(--font-heading);
		font-size: clamp(2.1rem, 7vw, 3rem);
		color: var(--color-text-dark);
		font-weight: 400;
		letter-spacing: 1px;
		margin-bottom: 14px;
		animation: fadeInUp 0.8s ease forwards 0.2s;
	}

	.loading-bar-container {
		width: min(220px, 62vw);
		height: 4px;
		background: rgba(2, 56, 89, 0.12);
		border-radius: 999px;
		margin: 0 auto 12px;
		overflow: hidden;
	}

	.loading-bar {
		width: 0;
		height: 100%;
		background: linear-gradient(90deg, #7db8d5, #023859, #7db8d5);
		border-radius: inherit;
		transition: width 0.3s ease;
	}

	.preloader-subtitle {
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #47718a;
	}

	@keyframes fadeInUp {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.preloader-fade-out {
		opacity: 0;
		visibility: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.invitation-animation { animation: none; }
		.invitation-image, .loading-bar { transition-duration: 0.01ms; }
	}
</style>

<script>
	const imagesToPreload = [
		'/assets/cerrado.webp',
		'/assets/abierto.webp',
		'/assets/hero_bg.jpg',
		'/assets/fondo-ver.webp',
		'/assets/largo.webp',
		'/assets/colores.webp',
		'/assets/WhatsApp.svg',
		'/assets/vineta.webp',		
		'/assets/cake.webp',
		'/assets/salon.webp',
		'/assets/music/music.mp3'
	];

	let loadedCount = 0;
	let animationStarted = false;
	const preloader = document.getElementById('preloader');
	const progressBar = document.getElementById('preload-progress');
	const invitation = document.querySelector('.invitation-animation');

	const triggerEntranceAnimation = () => {
		if (animationStarted) return;
		animationStarted = true;

		setTimeout(() => {
			invitation?.classList.add('opened');

			setTimeout(() => {
				preloader?.classList.add('preloader-fade-out');
				setTimeout(() => {
					if (preloader instanceof HTMLElement) preloader.style.display = 'none';
					document.dispatchEvent(new CustomEvent('website-ready'));
				}, 800);
			}, 1200);
		}, 700);
	};

	const updateProgress = () => {
		loadedCount++;
		const percentage = Math.round((loadedCount / imagesToPreload.length) * 100);
		if (progressBar instanceof HTMLElement) progressBar.style.width = `${percentage}%`;
		if (loadedCount >= imagesToPreload.length) triggerEntranceAnimation();
	};

	const fallbackTimeout = setTimeout(() => {
		if (!animationStarted) {
			if (progressBar instanceof HTMLElement) progressBar.style.width = '100%';
			triggerEntranceAnimation();
		}
	}, 6000);

	imagesToPreload.forEach((src) => {
		const image = new Image();
		image.onload = updateProgress;
		image.onerror = updateProgress;
		image.src = src;
	});

	window.addEventListener('beforeunload', () => clearTimeout(fallbackTimeout), { once: true });
</script>
