---
const { telefono } = Astro.props;
const textoSinEspacios = telefono.replaceAll(/\s/g, "");
const whatsappLink = `https://api.whatsapp.com/send?phone=57${textoSinEspacios}&text=Hola%2C%20confirmo%20mi%20asistencia%20a%20tu%20fiesta%20de%20cumplea%C3%B1os.%20%C2%A1Nos%20vemos%20all%C3%AD%21`;
---
    <div class="confirm-message">
      <p class="confirmar">Confirmar Asistencia</p>
      <a
        href={whatsappLink}
        target="_blank"
        class="btn whatsapp-btn"
      >
        <img
          src="/assets/WhatsApp.svg"
          class="whatsapp-icon"
          alt="WhatsApp"
        />{telefono}
      </a>
    </div>
<style>
  .confirmar { font-size: 1.5rem; font-weight: 500; color: var(--primary); margin-bottom: 0.5rem; }
  .confirm-message { padding: 1rem 0 2rem; margin: auto; }
  .whatsapp-btn {
    font-size: 1.1rem;
    background: var(--gradient-blue-metallic);
  }
 .whatsapp-icon {
        width: 20px;
        height: 20px;
        margin-right: 0.5rem;
    }



  .btn {
    padding: 1rem;
    border-radius: 10%;
  }
</style>
