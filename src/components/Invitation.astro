<section class="invitation-section">
<div class="names-container">
    <h2 class="invtation-name__parents reveal-item">Ada Tereza Forero Peña</h2> 
        <h3 class="reveal-item reveal-item--delay-1">&</h3> 
    <h2 class="invtation-name__parents reveal-item reveal-item--delay-2">Luis Alberto Peña Puentes</h2>
    <p class="invitation-text reveal-item reveal-item--delay-3">Nos complace invitarle a celebrar este día tan especial, los quince años de nuestra hija:</p>
     <h2 class="invitation-name reveal-item reveal-item--delay-4">Sharon Valeria</h2>
</div>
</section>


<style>

.names-container {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: min(100%, 900px);
    max-height: 88vh;
    overflow: hidden;
}

.reveal-item {
    opacity: 0;
    transform: translateY(24px);
    animation: revealUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.1s;
}

.reveal-item--delay-1 {
    animation-delay: 0.25s;
}

.reveal-item--delay-2 {
    animation-delay: 0.4s;
}

.reveal-item--delay-3 {
    animation-delay: 0.55s;
}

.reveal-item--delay-4 {
    animation-delay: 0.7s;
}

.invtation-name__parents {
    font-size: 4rem;
    text-align: center;
}
h3 {
    font-size: 3.5rem;
    text-align: center;
    font-style: oblique;
}

.invitation-section {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 1rem;
        background-image: url('/assets/fondo-ver.webp');
        background-size: cover;
        background-position: center;
    }

.invitation-name {
		font-family: var(--font-heading);
		font-size: 4rem;
        text-align: center;
		color: #ffffff;
		font-weight: 400;
		line-height: 0.9;
		background: linear-gradient(135deg, #0c0255 0%, #041223 50%, #033d77 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.3));
	}


    .invitation-text {
        font-size: 1.5rem;
        font-family:'Montserrat', sans-serif;
        font-style: italic;
        text-align: center;     
    }

    @media screen and (max-height: 700px) {
        .invitation-section {
            align-items: flex-start;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
        }

        .names-container {
            max-height: 88vh;
            padding: 1.5rem;
            gap: 0.75rem;
        }

        .invtation-name__parents,
        .invitation-name {
            font-size: clamp(2rem, 5vw, 3rem);
        }

        h3 {
            font-size: clamp(1.75rem, 4vw, 2.5rem);
        }

        .invitation-text {
            font-size: clamp(1rem, 3vw, 1.25rem);
        }
    }

    @keyframes revealUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }



</style>