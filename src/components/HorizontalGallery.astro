<section class="gallery-section" aria-label="Galería de recuerdos">
	<div class="gallery-carousel">
		<button class="gallery-control prev" type="button" aria-label="Ver imagen anterior">&#10094;</button>

		<div class="gallery-viewport" id="gallery-viewport">
			<div class="gallery-track" id="gallery-track">
				<div class="gallery-slide">
					<div class="slide-card">
						<div class="slide-img-frame">
							<img src="/assets/013.png" alt="Victoria en su sesión de fotos" class="slide-img" />
							<div class="frame-border"></div>
						</div>
						<div class="slide-info">
							<span class="slide-num">01 / 03</span>
							<h3>El Comienzo del Sueño</h3>
							<p>Cada día es una nueva oportunidad para brillar, soñar en grande y dar gracias por las bendiciones de la vida.</p>
						</div>
					</div>
				</div>

				<div class="gallery-slide">
					<div class="slide-card invert">
						<div class="slide-info">
							<span class="slide-num">02 / 03</span>
							<h3>Detalles con Magia</h3>
							<p>Los pequeños instantes, los brillos de plata y los detalles con amor son los que hacen esta noche eterna.</p>
						</div>
						<div class="slide-img-frame">
							<img src="/assets/014.png" alt="Tiara de quinceañera" class="slide-img" />
							<div class="frame-border"></div>
						</div>
					</div>
				</div>

				<div class="gallery-slide">
					<div class="slide-card">
						<div class="slide-img-frame">
							<img src="/assets/015.png" alt="El pastel de 15 años" class="slide-img" />
							<div class="frame-border"></div>
						</div>
						<div class="slide-info">
							<span class="slide-num">03 / 03</span>
							<h3>Un Dulce Recuerdo</h3>
							<p>Quiero compartir con ustedes la dulzura de festejar un nuevo capítulo lleno de alegría, ilusiones y felicidad.</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<button class="gallery-control next" type="button" aria-label="Ver imagen siguiente">&#10095;</button>
	</div>

	<div class="gallery-dots" role="tablist" aria-label="Seleccionar imagen">
		<button class="gallery-dot active" type="button" aria-label="Ir a la imagen 1"></button>
		<button class="gallery-dot" type="button" aria-label="Ir a la imagen 2"></button>
		<button class="gallery-dot" type="button" aria-label="Ir a la imagen 3"></button>
	</div>

	<div class="vineta-container">
		<img src="/assets/vineta.webp" class="vineta-image" alt="~">
	</div>
</section>

<style>
	.gallery-section {
		width: 100%;
		padding: 80px 20px 60px;
		box-sizing: border-box;
		background: radial-gradient(circle at center, #0f2547 0%, #050d18 100%);
	}

	.gallery-carousel {
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr) 48px;
		align-items: center;
		gap: 16px;
		max-width: 1220px;
		margin: 0 auto;
	}

	.gallery-viewport {
		overflow: hidden;
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.04);
		padding: 16px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
		min-height: 580px;
		touch-action: pan-y;
	}

	.gallery-track {
		display: flex;
		width: 100%;
		height: 100%;
		transition: transform 0.35s ease;
		will-change: transform;
	}

	.gallery-slide {
		flex: 0 0 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8px 8px 12px;
		box-sizing: border-box;
	}

	.slide-card {
		display: flex;
		align-items: center;
		gap: 60px;
		width: 100%;
		min-height: 520px;
	}

	.slide-card.invert {
		flex-direction: row-reverse;
	}
	.vineta-container {
		max-width: 100%;
		height: 6rem;
		display: flex;
		justify-content: center;
		align-items: center;
	}
	.vineta-image {
		max-width: 100%;
		height: auto;

	}


	.slide-img-frame {
		position: relative;
		flex: 1 1 50%;
		height: 100%;
		max-height: 600px;
		min-height: 300px;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 25px 55px rgba(0, 0, 0, 0.5);
		border: 1.5px solid rgba(255, 255, 255, 0.1);
	}

	.slide-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}

	.slide-img-frame:hover .slide-img {
		transform: scale(1.05);
	}

	.frame-border {
		position: absolute;
		top: 15px;
		left: 15px;
		right: 15px;
		bottom: 15px;
		border: 1.5px solid rgba(226, 232, 240, 0.4);
		border-radius: 8px;
		pointer-events: none;
	}

	.slide-info {
		flex: 1 1 50%;
		color: #ffffff;
		display: flex;
		flex-direction: column;
		justify-content: center;
		max-width: 420px;
	}

	.slide-num {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-silver-300);
		letter-spacing: 2px;
		margin-bottom: 15px;
	}

	.slide-info h3 {
		font-family: var(--font-heading);
		font-size: 2.2rem;
		color: #ffffff;
		margin-bottom: 20px;
		font-weight: 600;
		text-shadow: 0 2px 4px rgba(0,0,0,0.3);
	}

	.slide-info p {
		font-family: var(--font-body);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-silver-200);
	}

	.gallery-control {
		border: none;
		background: rgba(255, 255, 255, 0.12);
		color: #ffffff;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		cursor: pointer;
		display: grid;
		place-items: center;
		font-size: 1.2rem;
		transition: transform 0.2s ease, background 0.2s ease;
	}

	.gallery-control:hover {
		background: rgba(255, 255, 255, 0.22);
		transform: scale(1.04);
	}

	.gallery-control:focus-visible,
	.gallery-dot:focus-visible {
		outline: 3px solid #ffffff;
		outline-offset: 3px;
	}

	.gallery-dots {
		display: flex;
		justify-content: center;
		gap: 10px;
		margin-top: 24px;
	}

	.gallery-dot {
		width: 10px;
		height: 10px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.35);
		cursor: pointer;
		transition: transform 0.2s ease, background 0.2s ease;
	}

	.gallery-dot.active {
		background: var(--gradient-silver);
		transform: scale(1.15);
	}

	@media (max-width: 920px) {
		.gallery-carousel {
			grid-template-columns: 1fr;
		}

		.gallery-control {
			display: none;
		}

		.gallery-viewport {
			min-height: auto;
			padding: 10px;
		}

		.slide-card {
			flex-direction: column !important;
			gap: 25px;
			justify-content: center;
			min-height: auto;
		}

		.slide-img-frame {
			flex: none;
			width: 100%;
			max-height: 100dvh;
			min-height: 260px;
		}

		.slide-info {
			flex: none;
			width: 100%;
			text-align: center;
			align-items: center;
		}

		.slide-info h3 {
			font-size: 1.8rem;
			margin-bottom: 10px;
		}

		.slide-info p {
			font-size: 0.9rem;
		}
	}
</style>

<script>
	const track = document.getElementById('gallery-track');
	const viewport = document.getElementById('gallery-viewport');
	const prevButton = document.querySelector('.gallery-control.prev');
	const nextButton = document.querySelector('.gallery-control.next');
	const dots = Array.from(document.querySelectorAll('.gallery-dot'));
	const slides = Array.from(track?.children ?? []);

	let currentIndex = 0;
	let startX = 0;

	const updateCarousel = () => {
		if (!track) return;

		track.style.transform = `translateX(-${currentIndex * 100}%)`;
		dots.forEach((dot, index) => {
			dot.classList.toggle('active', index === currentIndex);
		});
	};

	const goToSlide = (index) => {
		if (!slides.length) return;
		currentIndex = (index + slides.length) % slides.length;
		updateCarousel();
	};

	prevButton?.addEventListener('click', () => goToSlide(currentIndex - 1));
	nextButton?.addEventListener('click', () => goToSlide(currentIndex + 1));

	dots.forEach((dot, index) => {
		dot.addEventListener('click', () => goToSlide(index));
	});

	viewport?.addEventListener('touchstart', (event) => {
		if (event.touches.length === 1) {
			startX = event.touches[0].clientX;
		}
	}, { passive: true });

	viewport?.addEventListener('touchend', (event) => {
		if (startX === 0) return;

		const endX = event.changedTouches[0].clientX;
		const deltaX = endX - startX;

		if (deltaX > 50) {
			goToSlide(currentIndex - 1);
		} else if (deltaX < -50) {
			goToSlide(currentIndex + 1);
		}

		startX = 0;
	}, { passive: true });

	window.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowLeft') {
			goToSlide(currentIndex - 1);
		} else if (event.key === 'ArrowRight') {
			goToSlide(currentIndex + 1);
		}
	});

	updateCarousel();
</script>
