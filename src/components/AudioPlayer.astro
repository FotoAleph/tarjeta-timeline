---
---
<div class="audio-control-container">
	<button id="audio-toggle" class="audio-btn" aria-label="Activar música de fondo">
		<div class="eq-container">
			<span class="eq-bar bar1"></span>
			<span class="eq-bar bar2"></span>
			<span class="eq-bar bar3"></span>
			<span class="eq-bar bar4"></span>
		</div>
		<svg class="mute-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<line x1="1" y1="1" x2="23" y2="23" class="mute-line"></line>
			<path d="M9 9v6a3 3 0 0 0 3 3h1.586l4.707 4.707A1 1 0 0 0 20 22V4a1 1 0 0 0-1.707-.707L13.586 8H12a3 3 0 0 0-3 3z"></path>
		</svg>
	</button>
	<span class="audio-tooltip">Activar Música</span>
</div>

<style>
	.audio-control-container {
		position: fixed;
		bottom: 30px;
		right: 30px;
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.audio-btn {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: rgba(15, 37, 71, 0.75); /* Dark blue translucent */
		border: 2px solid rgba(203, 213, 225, 0.6); /* Silver border */
		color: var(--color-silver-100);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		box-shadow: 0 8px 32px rgba(15, 37, 71, 0.3), 
					inset 0 2px 8px rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.audio-btn:hover {
		transform: scale(1.1);
		border-color: #ffffff;
		box-shadow: 0 12px 40px rgba(15, 37, 71, 0.4), 
					inset 0 2px 12px rgba(255, 255, 255, 0.3);
	}

	.audio-btn:active {
		transform: scale(0.95);
	}

	.audio-btn:focus-visible {
		outline: 3px solid #ffffff;
		outline-offset: 3px;
	}

	.mute-icon {
		width: 24px;
		height: 24px;
		position: absolute;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.eq-container {
		display: none;
		align-items: flex-end;
		justify-content: space-between;
		width: 20px;
		height: 18px;
		position: absolute;
	}

	.eq-bar {
		width: 3px;
		height: 100%;
		background-color: var(--color-silver-200);
		border-radius: 2px;
		transform-origin: bottom;
		animation: bounce 1s ease-in-out infinite alternate;
	}

	.bar1 { animation-delay: 0.1s; height: 30%; }
	.bar2 { animation-delay: 0.4s; height: 60%; }
	.bar3 { animation-delay: 0.2s; height: 80%; }
	.bar4 { animation-delay: 0.5s; height: 40%; }

	@keyframes bounce {
		0% { transform: scaleY(0.2); }
		100% { transform: scaleY(1); }
	}

	/* Toggle State classes */
	.playing .mute-icon {
		opacity: 0;
		transform: scale(0.5);
	}

	.playing .eq-container {
		display: flex;
	}

	.audio-tooltip {
		background: rgba(15, 37, 71, 0.85);
		border: 1px solid rgba(203, 213, 225, 0.4);
		color: var(--color-silver-100);
		padding: 8px 16px;
		border-radius: 20px;
		font-size: 0.85rem;
		font-family: var(--font-body);
		font-weight: 500;
		white-space: nowrap;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
		opacity: 0;
		transform: translateX(15px);
		pointer-events: none;
		transition: all 0.3s ease;
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.audio-control-container:hover .audio-tooltip {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 768px) {
		.audio-control-container {
			bottom: 20px;
			right: 20px;
		}
		.audio-tooltip {
			display: none; /* Hide tooltip on mobile for space */
		}
	}
</style>

<!-- Reproducer audio usando archivo estático -->
<audio id="bg-audio" src="/assets/music/music.mp3" loop preload="auto"></audio>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('audio-toggle');
    const container = document.querySelector('.audio-control-container');
    const tooltip = document.querySelector('.audio-tooltip');
    const audio = document.getElementById('bg-audio');

    if (!toggleBtn || !container || !audio) return;

    // Ensure correct typing in TS/JS environments
    const bgAudio = /** @type {HTMLAudioElement} */ (audio);
    bgAudio.volume = 0.6;

    function setPlayingState(isPlaying) {
        if (isPlaying) {
            toggleBtn.classList.add('playing');
            container.classList.add('playing');
            if (tooltip) tooltip.textContent = 'Silenciar';
        } else {
            toggleBtn.classList.remove('playing');
            container.classList.remove('playing');
            if (tooltip) tooltip.textContent = 'Activar Música';
        }
    }

    toggleBtn.addEventListener('click', async () => {
        if (!bgAudio.paused) {
            bgAudio.pause();
            setPlayingState(false);
            return;
        }

        try {
            const playResult = bgAudio.play();
            if (playResult !== undefined) {
                await playResult;
            }
            setPlayingState(true);
        } catch (err) {
            // Play was prevented (autoplay policy). Show tooltip message.
            console.warn('No se pudo iniciar la reproducción automática:', err);
            if (tooltip) tooltip.textContent = 'Toca para reproducir';
        }
    });

    // If audio ends (shouldn't because loop=true), clear state
    bgAudio.addEventListener('pause', () => setPlayingState(false));
    bgAudio.addEventListener('play', () => setPlayingState(true));
});
</script>
