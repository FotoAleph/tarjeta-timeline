---
const telefono = "322 2165433";
const textoSinEspacios = telefono.replaceAll(/\s/g, "");
const whatsappLink = `https://api.whatsapp.com/send?phone=57${textoSinEspacios}&text=Hola%2C%20confirmo%20mi%20asistencia%20a%20tu%20fiesta%20de%20cumplea%C3%B1os.%20%C2%A1Nos%20vemos%20all%C3%AD%21`;
---

<section id="details-rsvp" class="footer-info-section">
	<div class="info-container">
		<!-- Details Section -->
		<div class="details-grid">
			<!-- Card 1: Ubicación -->
			<div class="details-card info-animate">
				<div class="calendario">
					<img
						src="/assets/calendario.webp"
						class="calendario-image"
						alt="Calendario del evento"
					/>
				</div>
				<span class="card-main-val">29 de agosto</span>

				<p class="nomeclatura">Recepcion:6:00 PM</p>
				<p class="nomeclatura">Entrada Quinceñera: 7:00 PM</p>
				<a
					href="https://calendar.app.google/xPY8PofGcPGxbQLP6"
					target="_blank"
					rel="noopener noreferrer"
					class="card-action-btn btn"
				>
					<span>Recordar en mi calendario</span>
				</a>
			</div>
			<div class="details-card info-animate">
				<div class="salon">
					<img
						src="/assets/salon.webp"
						class="salon-image"
						alt="Salón social del lugar del evento"
					/>
				</div>
				<span class="card-main-val">Torres del Porvenir</span>

				<p class="nomeclatura">
					Calle 54c sur No. 100 - 24, Bogotá, Colombia
				</p>
				<a
					href="https://maps.app.goo.gl/hpozyuMTXLNJycin7"
					target="_blank"
					rel="noopener noreferrer"
					class="card-action-btn btn"
				>
					<span class="button-label"
						><svg
							class="card-icon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
						>
							<path
								d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
							></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
						Ver en maps</span
					>
				</a>
			</div>

			<!-- Card 2: Vestimenta -->
			<div class="details-card info-animate">
				<div class="dress-indicators">
					<div class="dress-item">
						<img
							src="/assets/traje.webp"
							alt="" aria-hidden="true"
							class="dress-icon"
						/>
					</div>
					<div class="dress-item">
						<img
							src="/assets/dress.webp"
							alt="" aria-hidden="true"
							class="dress-icon"
						/>
					</div>
				</div>
				<h3 class="card-title">Código de Traje</h3>
			
				<p>
					El encanto de esta noche se viste de gala. Damas y
					caballeros, los invito a lucir sus mejores trajes para
					compartir conmigo un momento lleno de elegancia y felicidad.
				</p>
				<div class="dress-color">
					<img
						src="/assets/colores.webp"
						alt="Colores del dress code: azul oscuro y rojo"
						class="dress-color__image"
					/>
				</div>
			</div>

			<!-- Card 3: Regalos -->
			<div class="details-card info-animate">
				<div class="card-icon-wrapper">
					<img
						src="/assets/gift-box.svg"
						class="icon-card"
						alt="" aria-hidden="true"
					/>
				</div>
				<h3 class="card-title">Lluvia de Sobres</h3>
				<span class="card-main-val">El regalo es en Sobre</span>
				<p>
					Tu asistencia es nuestro mayor regalo. Pero si deseas
					hacernos un obsequio, dispondremos de un cofre para recibir
					sobres en la entrada.
				</p>
			</div>
		</div>
<div  class="details-card info-animate">
		<div class="confirm-message">
			<h2>Confirmar Asistencia</h2>
			<p class="confirmar">
				Porque los grandes momentos se comparten con quienes más queremos... ¡Esperamos contar contigo! Confirma tu lugar aquí
			</p>
			<a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn whatsapp-btn">
				<img
					src="/assets/WhatsApp.svg"
					class="whatsapp-icon"
					alt="WhatsApp"
				/>{telefono}
			</a>
		</div>
		</div>
		<img
			src="/assets/012.webp"
			alt="Foto de Sharon Valeria"
			class="decorative-image"
		/>

		<!-- Elegant Signature Footer -->
		<footer class="footer-signature">
			<span class="footer-calligraphy">Sharon Valeria</span>
			<span class="footer-tagline">Mis Quince Años</span>
			<div class="footer-divider"></div>
			<span class="footer-copy"
				>valoramos su presencia en este día que quedará en la memoria de
				nuestra familia.</span
			>
		</footer>
	</div>
</section>

<style>
	.footer-info-section {
		padding: 120px 0 60px 0;
		background:
			radial-gradient(circle at 85% 15%, rgba(255, 255, 255, 0.8) 0%, transparent 26%),
			linear-gradient(180deg, var(--color-bg-light) 0%, var(--color-bg-alt) 100%);
		position: relative;
		width: 100%;
		z-index: 10;
	}

	.info-container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		flex-direction: column;
		gap: 80px;
	}

	/* Details Cards Grid */
	.details-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 30px;
	}

	.details-card {
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(233, 247, 255, 0.76));
		border: 1.5px solid rgba(226, 232, 240, 0.8);
		border-radius: 20px;
		padding: 40px 30px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-shadow: var(--shadow-metallic);
		transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	.details-card:hover {
		transform: translateY(-8px);
		border-color: rgba(96, 165, 250, 0.4);
		box-shadow: 0 20px 40px rgba(15, 37, 71, 0.08);
	}

	.card-icon-wrapper {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: rgba(30, 64, 175, 0.06);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 25px;
		color: var(--color-text-dark);
		border: 1px solid rgba(30, 64, 175, 0.15);
	}

	.card-icon {
		width: 28px;
		height: 28px;
	}

	.details-card h3 {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		color: var(--color-text-dark);
		margin-bottom: 15px;
		font-weight: 600;
	}

	.card-main-val {
		font-family: var(--font-body);
		font-weight: 700;
		color: #1e40af;
		font-size: 1rem;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin-bottom: 10px;
	}

	.details-card p {
		font-family: var(--font-body);
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--color-silver-600);
		margin-bottom: 20px;
	}

	/* Map button */
	.card-action-btn {
		margin-top: auto;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 10px 14px;
		border-radius: 12px;
		background: linear-gradient(135deg, #17658c, #123754);
		color: #ffffff;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
		letter-spacing: 1px;
		text-transform: uppercase;
		box-shadow: 0 6px 18px rgba(7, 89, 133, 0.22);
		border: 1px solid #06476b;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			opacity 0.18s ease,
			background 0.18s ease;
		min-width: 140px;
	}

	.button-label {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	.btn:hover {
		transform: translateY(-3px);
		box-shadow: 0 14px 34px rgba(7, 89, 133, 0.3);
		background: linear-gradient(135deg, #123754, #17658c);
	}

	.btn:focus-visible {
		outline: 3px solid #0f172a;
		outline-offset: 3px;
	}

	.icon-card {
		width: 5rem;
		height: 5rem;
		transition: transform 0.3s ease;
	}

	.card-title {
		padding: 1rem;
		font-size: 3rem;
	}

	/* Dress indicators */
	.dress-indicators {
		display: flex;
		justify-content: space-around;
		gap: 1rem;
		margin-top: auto;
	}

	.dress-item {
		width: 42%;
		
		display: flex;
		justify-content: center;
		background: transparent;
		border: none;
		padding: 0;
		border-radius: 0;
	}

	.dress-item > img {
		max-width: 90%;
		max-height:fit-content;
		margin: auto;	
	}

	.salon {
		width: 100%;
		display: flex;
		justify-content: center;
		height: auto;
		padding: 0;
	}
	.salon-image {
		max-width: fit-content;
		width: 75%;
		height: auto;
	}

	/* Signature Footer */
	.footer-signature {
		text-align: center;
		margin-top: 40px;
		border-top: 1px solid rgba(148, 163, 184, 0.2);
		padding-top: 60px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.footer-calligraphy {
		font-family: var(--font-accent);
		font-size: 4rem;
		color: var(--color-text-dark);
		line-height: 0.8;
		margin-bottom: 10px;
	}

	.footer-tagline {
		font-family: var(--font-heading);
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 5px;
		color: var(--color-silver-400);
		font-weight: 300;
		margin-bottom: 25px;
	}

	.footer-divider {
		width: 50px;
		height: 1.5px;
		background: var(--color-silver-300);
		margin-bottom: 25px;
	}

	.footer-copy {
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 1px;
		color: var(--color-silver-400);
	}

	.calendario {
		width: 100%;
		display: flex;
		justify-content: center;

	}
	.calendario-image {
		width: 6rem;
		padding: 0;
	}

	.dress-color {
		width: 100%;
	}
	.dress-color__image {
		max-width: 88%;
		height: auto;
	}
	.confirmar {
		font-size: 1.5rem;
		font-weight: 500;
		color: var(--color-text-dark);
		margin-bottom: 0.5rem;
	}
	.confirm-message {
		padding: 1rem 0 2rem;
		margin: auto;
	}
	.whatsapp-btn {
		font-size: 1.1rem;
	}
	.whatsapp-icon {
		width: 20px;
		height: 20px;
		margin-right: 0.5rem;
	}

	/* Responsive layouts */
	@media (max-width: 600px) {
		.footer-calligraphy {
			font-size: 3.2rem;
		}

		.footer-info-section {
			padding: 80px 0 40px 0;
		}
	}
</style>
