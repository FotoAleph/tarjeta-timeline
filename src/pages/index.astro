---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import SnowEffect from '../components/SnowEffect.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Hero from '../components/Hero.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import FooterInfo from '../components/FooterInfo.astro';
import Invitation from '../components/Invitation.astro';
import Countdown from '../components/Countdown.astro';
---

<Layout>
	<!-- Preloader screen with animated envelope -->
	<Preloader />
	
	<!-- Very light background snowfall canvas animation -->
	<SnowEffect />
	
	<!-- Synthesized Web Audio music player floating toggle button -->
	<AudioPlayer />
	
	<!-- Fullscreen elegant Hero section with premium image -->
	<Hero />

	<Countdown/>

	<Invitation />
	
	<!-- Full width horizontal scroll gallery (Scroll Interrupter) -->
	<HorizontalGallery />
	
	<!-- Event details: location, dress code, and gifts -->
	<FooterInfo />
</Layout>
